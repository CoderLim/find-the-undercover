.sw-home {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 96rpx;
}

.sw-brand {
  display: flex;
  align-items: center;
  gap: 24rpx;
  animation: rise-in 0.5s var(--ease) both;
}
.sw-title {
  font-size: 88rpx;
  font-weight: 700;
  letter-spacing: 12rpx;
  color: var(--ink);
}
.sw-seal {
  width: 76rpx;
  height: 76rpx;
  border-radius: 14rpx;
  background-color: var(--accent);
  color: #fffaf3;
  font-size: 44rpx;
  line-height: 76rpx;
  text-align: center;
  box-shadow: var(--shadow-soft);
}

.sw-rule-card {
  margin-top: 72rpx;
  width: 100%;
  animation: rise-in 0.5s 0.05s var(--ease) both;
}
.sw-rule-line {
  margin-top: 16rpx;
  font-size: 32rpx;
  line-height: 56rpx;
  color: var(--ink);
}

.sw-example {
  margin-top: 32rpx;
  padding-top: 28rpx;
  border-top: 2rpx dashed var(--border);
}
.sw-eg-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}
.sw-eg-char {
  position: relative;
  font-size: 60rpx;
  font-weight: 700;
  color: var(--ink);
  padding-bottom: 22rpx;
}
.sw-eg-add {
  position: absolute;
  left: 50%;
  bottom: -6rpx;
  transform: translateX(-50%);
  font-size: 22rpx;
  font-weight: 400;
  color: var(--accent);
  white-space: nowrap;
}
.sw-eg-plus {
  font-size: 36rpx;
  color: var(--muted);
}
.sw-eg-eq {
  font-size: 40rpx;
  color: var(--muted);
  margin: 0 6rpx;
}
.sw-eg-word {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--accent);
  letter-spacing: 6rpx;
}

.sw-actions {
  margin-top: auto;
  width: 100%;
  padding-top: 80rpx;
}
.sw-btn {
  width: 100%;
  line-height: 92rpx;
  height: 92rpx;
  border-radius: 999rpx;
  font-size: 34rpx;
  letter-spacing: 4rpx;
  text-align: center;
}
